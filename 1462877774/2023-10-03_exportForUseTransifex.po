msgstr "Il sonne un peu plus grave."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "Is that what the ocean sounds like?"
msgstr "Est-ce ça, le bruit de l'océan ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "It's ready for the high C's."
msgstr "Ce n'est pas grave d'être si aigu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SISTURN.GENERIC"
msgid "Some flowers would liven it up a bit."
msgstr "Quelques fleurs l'animeraient un peu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
