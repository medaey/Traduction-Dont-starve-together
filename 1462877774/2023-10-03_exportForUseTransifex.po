msgstr "23 avril"

#. STRINGS.CHARACTER_BIOS.wilson.1.title
msgctxt "STRINGS.CHARACTER_BIOS.wilson.1.title"
msgid "Birthday"
msgstr "Anniversaire"

#. STRINGS.CHARACTER_BIOS.wilson.2.desc
msgctxt "STRINGS.CHARACTER_BIOS.wilson.2.desc"
msgid "Bacon and Eggs"
msgstr "Bacon et œufs"

#. STRINGS.CHARACTER_BIOS.wilson.2.title
