#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Shots to be slinged."
msgstr "Tirs à la fronde."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLURPER"
