msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "A home fit for a fish beast."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMKING"
msgid "Lord of the fish beasts!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.BURNT"
msgid "The throne hath been set ablaze!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Have you chosen a chieftain?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "'Tis a sad day for the fish beasts."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt ""
"STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
