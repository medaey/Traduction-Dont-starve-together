msgstr "Va falloir que je coupe ça."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL_WEBBED"
