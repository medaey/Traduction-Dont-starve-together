msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.ATTACKER"
msgid "I don't like the game you're playing."
msgstr "Je n'aime pas le jeu auquel tu joues."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.FIRESTARTER"
msgid "Hyuyu, how funny you are, %s!"
msgstr "Houhou, comme tu es drôle, %s !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.GENERIC"
msgid "Do my claws scare you? Hyuyu!"
msgstr "Tu n'as pas peur de mes griffes ? Houhou !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.GHOST"
msgid "Don't worry, I'm not gonna eat you."
msgstr "T'inquiète pas, je ne te mangerai pas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.MURDERER"
msgid "I was just playing around! Please don't hurt me!"
msgstr "Je rigolais ! Pitié, ne me fais pas mal !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WENDY.REVIVER"
msgid "Thanks for not eating that soul, %s!"
msgstr "Merci de ne pas avoir mangé cette âme, %s !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WEREITEM_BEAVER"
msgid "I do love a cursed trinket!"
msgstr "J'adore quand ça pue bien !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WEREITEM_GOOSE"
msgid "Let loose the goose!"
msgstr "Viande de la mer !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WEREITEM_MOOSE"
msgid "Weremoose? There moose!"
msgstr "Maudit soit leur nom !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.ATTACKER"
msgid "Those punches weren't part of the bit!"
msgstr "Ces coups de poing n'étaient pas au programme !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.FIRESTARTER"
msgid "Ooohoohoo, what have you been up to?"
msgstr "Oh, oh, oh ! Que devenais-tu ?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.GENERIC"
msgid "%s, let's practice our routine!"
msgstr "%s, entraînons-nous à nos exercices !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.GHOST"
msgid "%s, did you get more delicious?"
msgstr "%s, es-tu devenu plus délicieux ?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.MURDERER"
msgid "Don't hurt me, %s!"
msgstr "Ne me fais pas mal, %s !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WES.REVIVER"
msgid "Thank-you, thank-you, funny friend!"
msgstr "Merci, merci, mon drôle d'ami !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WETGOOP"
msgid "Hyuyu! How repulsive."
msgstr "Houhou ! Comme c'est dégoûtant !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WETPAPER"
msgid "Oh dear. Just mush now."
msgstr "Oh là là… c'est de la bouillie maintenant."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WETPOUCH"
msgid "It can barely contain itself!"
msgstr "Il n'arrive plus à se contenir !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WHIP"
msgid "Well this just seems cruel."
msgstr "Tout simplement cruel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "I'm sorry about the exploding pen gag, hyuyu!"
msgstr "Désolé pour la blague du coussin péteur, houhou !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "You're having too much fun, %s!"
msgstr "Vous vous amusez trop, %s !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "%s needs to have some fun."
msgstr "%s a besoin de s'amuser."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "Mmm, fresh soul!"
msgstr "Miam, une âme fraîche !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Hyuyu! Please don't kill me!"
msgstr "Houhou ! Pitié, me tuez pas !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "%s wouldn't lose a soul so easily!"
msgstr "%s n'est pas du genre à perdre une âme !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.ATTACKER"
msgid "Hey! That's not funny!"
msgstr "Eh ! C'est pas drôle !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Ooohoo, have you been playing pranks?"
msgstr "Houhou ! Tu fais des blagues ?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.GENERIC"
msgid "Oh, you're the funny one!"
msgstr "Oh, t'es une petite rigolote !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.GHOST"
msgid "Ooo, free soul!"
msgstr "Oh, une âme gratuite !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.MURDERER"
msgid "%s! You're just as bad as my old partner!"
msgstr "%s ! Tu ne vaux pas mieux que mon ancien partenaire !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILLOW.REVIVER"
msgid "Thanks for the leg up!"
msgstr "Merci pour le coup de patte !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.ATTACKER"
msgid "That was a mean prank, %s!"
msgstr "C'était une bien sale blague, %s !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.FIRESTARTER"
msgid "%s knows how to tell a joke!"
msgstr "%s s'y connaît en farces en tous genres !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.GENERIC"
msgid "Who wants to do science when you can play?"
msgstr "Qui a envie de faire de la science au lieu de jouer ?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WILSON.GHOST"
