msgstr "Un buisson qui ne brûle pas ? Comment ça ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "It, oh, it appears to be on fire."
msgstr "On dirait qu'il me suit."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "Crisp, non?"
msgstr "Squelette croustillant"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "It's working really well!"
msgstr "Ça se débrouille très bien tout seul."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "It's getting a bit low, Winona."
msgstr "Ça devient un peu... tiède."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "I suppose it needs fuel."
msgstr "Il lui faut du combustible."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "It, oh, it appears to be on fire."
msgstr "On dirait qu'il me suit."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "Crisp, non?"
msgstr "Squelette croustillant"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "I feel so safe now."
msgstr "Je suis trop intelligent maintenant !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It's not on."
msgstr "Il ne bouge pas."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "It, oh, it appears to be on fire."
msgstr "On dirait qu'il me suit."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Crisp, non?"
msgstr "Squelette croustillant"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "Oh good. I don't much like the dark out here."
msgstr "Oh oh... J'aime pas du tout ce truc-là."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.OFF"
