msgstr "C'est rouge parce que c'est plein de science."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
