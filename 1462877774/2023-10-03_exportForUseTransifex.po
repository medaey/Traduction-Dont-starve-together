msgstr "Merci, merci %s !"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAXWELLJOURNAL"
