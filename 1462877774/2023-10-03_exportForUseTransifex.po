#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
