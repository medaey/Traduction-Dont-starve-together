msgstr "Tout peut se cuire !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_OVERSIZED"
msgid "We want giant watermelon slices!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_SEEDS"
msgid "If we eat these will they grow inside us?"
msgstr "Si on les mange, elles vont pousser dans nous ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT"
msgid "Did we shrink? Or is this flower really big?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT_BABY"
msgid "Grow big and tall!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT_BOMB"
msgid "We're sorry! We didn't mean it!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPLANT_PLANTER"
msgid "Where should we put you?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERPUMP"
