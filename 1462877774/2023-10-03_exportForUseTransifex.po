msgstr "C'est un gros morceau de lune."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONGLASS_WOBSTER_DEN"
