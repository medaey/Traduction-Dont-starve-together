msgstr "Je te souhaite le bonjour."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_RECHARGERHAT"
