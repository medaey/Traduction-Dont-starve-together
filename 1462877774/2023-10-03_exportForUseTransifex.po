msgstr "Mon esprit a grandi !"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE"
